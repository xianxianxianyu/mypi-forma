# Optional: without a key, the UI clearly labels deterministic local demo mode.
# Copy to .env and set values locally. Never put credentials in VITE_* variables.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
# The Vite dev proxy expects 3001. If changed, update vite.config.ts too.
PORT=3001
