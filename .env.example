# Default: Pi CLI + DeepSeek Flash. The UI can switch between Pi and Codex per request.
# Both CLIs send prompts to their model providers; neither is offline inference.
FORMA_BACKEND=pi
PI_BIN=pi
PI_MODEL=deepseek-flash
# Optional existing Pi auth/models directory; defaults to PI_CODING_AGENT_DIR or ~/.pi/agent.
# PI_AGENT_DIR=/absolute/path/to/pi-agent-dir
# Pi can also use a server-side DEEPSEEK_API_KEY. Never expose it through VITE_*.

CODEX_BIN=codex
# Optional override; empty means Codex's built-in default (user config is not loaded).
CODEX_MODEL=
# Optional: set CODEX_HOME if your local Codex authentication lives in another home.
# CODEX_HOME=/absolute/path/to/codex-home

# Explicit dedicated alternatives: demo (fixed rules, no AI) or openai.
# Dedicated demo/openai services cannot switch to a CLI from the browser.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# API and web development ports. Keep PORT and API_PORT aligned.
PORT=3001
API_PORT=3001
VITE_PORT=5173
